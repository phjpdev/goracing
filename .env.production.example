# Generate a new secret: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_NEW_SECRET

# Database password for PostgreSQL
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Gemini AI for race analysis
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# gemini-2.5-flash-lite is no longer available to new Google projects.
GEMINI_MODEL=gemini-3.5-flash-lite

# Set to 1 to stop the 60s HKJC meetings polling (e.g. while the upstream
# allowlist is blocking this server). Set back to 0 once access is restored.
DISABLE_MEETINGS_WARMER=0
